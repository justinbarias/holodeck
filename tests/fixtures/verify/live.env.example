# Copy to .verify/live.env (gitignored) and fill in; `make verify-live` loads it.
# Variables already exported in your shell take precedence.
#
# Claude Agent SDK backend. Create a token with `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=
# OpenAI Agents SDK backend. Also the embedding key for the vectorstore and
# hierarchical_document cases on BOTH backends: without it those cases SKIP.
OPENAI_API_KEY=
# Hosted vector stores with no local emulator. Each provider's cases run only
# when ALL of its variables are set; otherwise they report SKIP with the reason.
# Every run uses a uniquely named index and deletes it afterwards.
# Pinecone (serverless index in aws/us-east-1).
PINECONE_API_KEY=
# Azure AI Search: service endpoint (https://<name>.search.windows.net) and an
# admin key.
AZURE_AI_SEARCH_ENDPOINT=
AZURE_AI_SEARCH_API_KEY=
