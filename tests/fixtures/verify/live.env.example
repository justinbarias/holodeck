# Copy to .verify/live.env (gitignored) and fill in; `make verify-live` loads it.
# Variables already exported in your shell take precedence.
#
# Claude Agent SDK backend. Create a token with `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=
# OpenAI Agents SDK backend. Also the embedding key for the vectorstore and
# hierarchical_document cases on BOTH backends: without it those cases SKIP.
OPENAI_API_KEY=
