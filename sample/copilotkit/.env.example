# HoloDeck CopilotKit Frontend — Environment Configuration
# Copy this file to .env.local and fill in your values.

# Required — must match the `name` field in your agent.yaml
AGENT_ID=my_agent_replace_me

# Required — displayed in the header and browser tab
AGENT_TITLE=My Agent
AGENT_DESCRIPTION=What my agent does

# Optional — HoloDeck serve endpoint (default shown)
# HOLODECK_BACKEND_URL=http://127.0.0.1:8000/awp

# Optional — `accept` value for the file upload input. The default lists every
# type holodeck serve accepts (src/lib/supported-mime.ts); files of other types
# are not attached even if this list allows them.
# FILE_ACCEPT=image/png,image/jpeg,image/gif,image/webp,application/pdf,.docx,.xlsx,.pptx,.txt,.csv,.md
