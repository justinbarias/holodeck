# Copy to .env in this directory and fill in. HoloDeck and docker compose
# both read .env from the directory you run them in. Never commit .env.

# Model and embedding credential (provider openai in agent.yaml). For the
# Anthropic alternatives, see README.md.
OPENAI_API_KEY=replace-with-your-key

# Qdrant (vector store for both source tools).
QDRANT_URL=http://localhost:6333

# Neo4j (memory graph). compose.yaml sets the database password from
# NEO4J_PASSWORD; there is no default.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-password

# Host ports for compose.yaml. Change them if the defaults are in use, and
# change QDRANT_URL and NEO4J_URI to match.
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
